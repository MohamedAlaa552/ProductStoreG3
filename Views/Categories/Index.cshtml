@model List<Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Categories</h1>
    <a class="btn btn-primary" asp-action="Create">New category</a>
</div>

<table class="table table-striped">
    <thead>
        <tr><th>Name</th><th>Products</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@c.Id">@c.Name</a></td>
                <td>@c.Products.Count</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@c.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@c.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
